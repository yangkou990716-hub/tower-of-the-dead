{
  "name": "tower-of-the-dead",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "assets": "node scripts/gen-icons.mjs && python3 scripts/subset-font.py",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "proto": "vite --host",
    "proto:build": "vite build -c vite.proto.config.ts",
    "proto:preview": "vite preview -c vite.proto.config.ts --host",
    "test": "vitest run",
    "e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "fake-indexeddb": "^6.2.8",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
